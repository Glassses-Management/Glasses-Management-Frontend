# Used for production builds (npm run build / Vercel).
# The local .env points at localhost, which would break the deployed app, so the
# real API base URL must be set here.
VITE_API_BASE_URL=https://diplomatic-emotion-production-7e03.up.railway.app/api

# Google sign-in client id. Set this in Vercel as well, otherwise the Google
# button stays hidden in production.
VITE_GOOGLE_CLIENT_ID=
